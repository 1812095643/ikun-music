{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ikun音乐",
  "version": "5.3.2",
  "identifier": "com.ikun.music",
  "build": {
    "beforeDevCommand": "npm run prepare:music-api-runtime && npm run dev:web",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ikun音乐",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "runtime-stage/": "runtime/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMjYzNDQ4RTYxQkVBNkUKUldSdTZodm1TRFFtc1hNRU5WR0VzTjBWWUc1OUhnTThMSjdNbkJmb1B1OTh1S2p2U2VWTVIyMzMK",
      "endpoints": ["https://gitee.com/caixukun66666666/ikun-music/raw/main/updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
