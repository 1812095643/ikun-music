{
  "name": "ikun-music",
  "version": "5.3.13",
  "description": "ikun音乐",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write ./src/renderer",
    "lint": "eslint ./src/renderer --fix",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:web",
    "dev:web": "vite dev",
    "dev:mobile": "npm --prefix mobile run dev:h5",
    "build:mobile": "npm --prefix mobile run build:app",
    "dev": "tauri dev",
    "prepare:music-api-runtime": "node scripts/prepare-music-api-runtime.mjs",
    "build:desktop": "npm run prepare:music-api-runtime && npm run build:web -- --mode desktop",
    "build:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false && vite build",
    "check:android-env": "node scripts/check-android-env.mjs",
    "build:android:web": "npm run check:android-env && vue-tsc --noEmit -p tsconfig.web.json --composite false && vite build --mode android",
    "build": "tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk true",
    "android:run": "tauri android run",
    "lint:i18n": "jiti scripts/check_i18n.ts",
    "check:music-service": "node scripts/check-music-service.mjs",
    "package:desktop": "node scripts/package-desktop.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,vue,js,css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-opener": "2.5.0",
    "@tauri-apps/plugin-store": "2.4.0",
    "crypto-js": "^4.2.0",
    "husky": "^9.1.7",
    "jsencrypt": "^3.5.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue-i18n": "^11.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rushstack/eslint-patch": "^1.15.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/crypto-js": "^4.2.2",
    "@types/howler": "^2.2.12",
    "@types/node": "^20.19.26",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.25",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/runtime-core": "^3.5.25",
    "@vueuse/core": "^11.3.0",
    "animate.css": "^4.1.1",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.6.2",
    "eslint-plugin-vue-scoped-css": "^2.12.0",
    "globals": "^16.5.0",
    "howler": "^2.2.4",
    "lint-staged": "^15.5.2",
    "lodash": "^4.17.21",
    "marked": "^15.0.12",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "pinyin-match": "^1.2.10",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "remixicon": "^4.7.0",
    "sass": "^1.96.0",
    "tailwindcss": "^3.4.19",
    "tinycolor2": "^1.6.0",
    "tunajs": "^1.0.15",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.4.1",
    "vite-plugin-compression": "^0.5.1",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
