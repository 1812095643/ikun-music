{
  "name": "ikun-music",
  "version": "5.1.0",
  "description": "ikun音乐",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write ./src/renderer",
    "lint": "eslint ./src/renderer --fix",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:web",
    "dev:web": "vite dev",
    "dev": "tauri dev",
    "prepare:music-api-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-music-api-runtime.ps1",
    "build:desktop": "npm run prepare:music-api-runtime && npm run build:web",
    "build:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false && vite build",
    "build": "tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint:i18n": "jiti scripts/check_i18n.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,vue,js,css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.4.0",
